FABRIC_VERSION=2.5.15
COUCHDB_VERSION=3.4.2
COUCHDB_USER=admin
COUCHDB_PASSWORD=adminpw
FABRIC_ADAPTER_TOKEN=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-random-session-secret
SYNAPSENET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
PENALTY_EXECUTOR_TOKEN=replace-with-random-operations-secret
GOVERNANCE_TOKEN=replace-with-random-governance-secret
OPERATIONS_TOKEN=replace-with-random-audit-secret
REQUIRE_WALLET_FOR_CREDENTIALS=true
ALLOW_LEGACY_BUSINESS_SESSIONS=false
REQUIRE_CALLER_IDENTITY=true
FABRIC_MSP_DOMAINS_JSON={"Org1MSP":"org1.synapsenet.com"}
RECONCILE_INTERVAL_SECONDS=60
SYNAPSENET_COOKIE_SECURE=true
# Add one CA_BOOTSTRAP_<NORMALIZED_MSP_ID> secret for every approved organization.
CA_BOOTSTRAP_YOURMSPID=replace-with-random-ca-bootstrap-secret
PEER_ENROLLMENT_YOURMSPID=replace-with-random-peer-enrollment-secret
REVIEWER_ENROLLMENT_YOURMSPID=replace-with-random-reviewer-enrollment-secret
ACTOR_ENROLLMENT_SECRET=replace-with-per-actor-secret-from-secret-manager
CREDENTIAL_CHANNEL_NAME=credentials
TRUST_CHANNEL_NAME=trust-governance
RESTORE_DRILL_BACKUP=/secure/backups/synapsenet-release.db
FABRIC_ADAPTER_TOKEN_FILE=/run/secrets/synapsenet-fabric-adapter-token
ALERT_WEBHOOK_URL_FILE=/run/secrets/synapsenet-alert-webhook-url
METRICS_RETENTION=30d
INCIDENT_COMMANDER=replace-with-on-call-owner
INCIDENT_CONTACT=replace-with-escalation-channel
RELEASE_ID=replace-with-immutable-release-id
PHASE6_REQUEST_RATE=50
PHASE6_DURATION=10m
PHASE6_EVIDENCE_MANIFEST=/secure/release-evidence/phase6-release-evidence.json
DR_RPO_SECONDS=86400
DR_RTO_SECONDS=14400
DR_SECONDARY_SITE=replace-with-secondary-site
DR_OWNER=replace-with-disaster-recovery-owner
FABRIC_SNAPSHOT_EVIDENCE=/secure/release-evidence/fabric-snapshot-drill.txt
KEY_RECOVERY_EVIDENCE=/secure/release-evidence/key-recovery-drill.txt
