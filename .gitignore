# SynapseNet Project .gitignore

# -----------------------------------------------------------------------------
# General / OS / IDE files
# -----------------------------------------------------------------------------
.DS_Store
.env
backend-api-gateway/data/auth.json
backend-fastapi/data/
backend-fastapi/.venv/
__pycache__/
*.pyc
.env.*
.editorconfig
.idea/
.vscode/
*.swp
*.swo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report-*.yml
report-*.json
# Temporary files
tmp/
.temp/
temp/
# Build artifacts
dist/
build/
coverage/
# Test/Coverage reports
.nyc_output/
junit.xml

# -----------------------------------------------------------------------------
# Go (for Hyperledger Fabric Chaincode/SDK interactions)
# -----------------------------------------------------------------------------
# Binaries for programs
*.exe
*.dll
*.so
*.dylib

# Test binary, generated with `go test -c`
*.test

# Compiled Object files, generated by `go build` or `go test`
*.o

# Libraries and packages
vendor/

# Go module cache (if not in project root, e.g., for specific tools)
.go/
.gocache/

# Environment variables (if any specific to Go)
.env.go

# -----------------------------------------------------------------------------
# Node.js / JavaScript / TypeScript (for Frontend, Backend API Gateway)
# -----------------------------------------------------------------------------
node_modules/
#yarn.lock
package-lock.json

# Production deployments often bundle client-side code into "build" or "dist"
/build
/dist
/public/build
/public/dist

# Node.js / JavaScript / TypeScript
node_modules/
#yarn.lock
package-lock.json

/build
/dist
/public/build
/public/dist

# TypeScript build output
*.js.map
*.d.ts
*.tsbuildinfo

# dotenv files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Generated Hyperledger Fabric material (contains private keys)
fabric-network-config/crypto-config/
fabric-network-config/channel-artifacts/
crypto-config/
channel-artifacts/
config_update.json
decoded_channel.json
envelope.json

# npm package manager cache
.npm

# optional npm cache directory
.cache/

# TypeScript build output
*.js.map
*.d.ts
*.tsbuildinfo

# Next.js/Gatsby/Vue/React specific files
.next/
.nuxt/
.vuepress/dist
.cache/
.parcel-cache/

# -----------------------------------------------------------------------------
# Docker
# -----------------------------------------------------------------------------
# Ignore Docker build contexts
.dockerignore
# Docker compose files for development/testing environments (if they contain secrets)
docker-compose.override.yml
# Compiled Docker images
*.img

# Kubernetes (if local dev setup uses tools like Minikube/Kind)
.kube/config

# -----------------------------------------------------------------------------
# Cloud Provider Specifics (e.g., AWS, GCP, Azure)
# -----------------------------------------------------------------------------
# Terraform/CloudFormation state files
*.tfstate
*.tfstate.backup

# Cloud credentials
.aws/credentials
.gcloud/credentials
.azure/credentials

# -----------------------------------------------------------------------------
# Logs (catch-all)
# -----------------------------------------------------------------------------
*.log
log/
logs/

# -----------------------------------------------------------------------------
# Other potential ignored files
# -----------------------------------------------------------------------------
*.zip
*.tar
*.rar
*.7z
*.tmp
*.bak
