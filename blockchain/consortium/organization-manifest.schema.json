{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynapseNet approved Fabric organization",
  "type": "object",
  "required": ["schemaVersion", "applicationId", "governanceReference", "approvedAt", "legalIdentity", "fabric"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "applicationId": { "type": "string" },
    "governanceReference": { "type": "string" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "legalIdentity": {
      "type": "object",
      "required": ["legalName", "displayName", "jurisdiction", "registrationNumber"]
    },
    "fabric": {
      "type": "object",
      "required": ["mspId", "domain", "peer", "ca", "channels", "roles", "enrollment"],
      "properties": {
        "mspId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{2,63}MSP$" },
        "domain": { "type": "string" },
        "peer": { "type": "string" },
        "ca": { "type": "string" },
        "channels": { "type": "object" },
        "roles": {
          "type": "object",
          "required": ["credentialIssuer", "trustGovernor"]
        },
        "enrollment": {
          "type": "object",
          "required": ["reviewerIds"],
          "properties": {
            "reviewerIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
