{
  "name": "synapsenet-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "services/api-gateway",
    "services/fabric-adapter",
    "blockchain/chaincode/*"
  ],
  "scripts": {
    "chaincode:build": "yarn workspace skill-manager build",
    "chaincode:test": "yarn workspace skill-manager test",
    "trust:build": "yarn workspace trust-manager build",
    "trust:test": "yarn workspace trust-manager test",
    "trust:deploy": "./infrastructure/scripts/deploy-trust-chaincode.sh",
    "trust:initialize": "./infrastructure/scripts/initialize-trust-policy.sh",
    "network:generate": "./infrastructure/scripts/generate-network.sh",
    "network:up": "./infrastructure/scripts/network-up.sh",
    "network:create-channel": "./infrastructure/scripts/create-channel.sh",
    "network:create-domain-channels": "./infrastructure/scripts/create-domain-channels.sh",
    "network:join-consortium-peers": "./infrastructure/scripts/join-consortium-peers.sh",
    "network:deploy": "./infrastructure/scripts/deploy-chaincode.sh",
    "network:test": "./infrastructure/scripts/smoke-test.sh",
    "network:down": "./infrastructure/scripts/network-down.sh",
    "network:reset": "./infrastructure/scripts/network-reset.sh",
    "users:list": "./infrastructure/scripts/list-users.sh",
    "auth:issue-reset": "node infrastructure/scripts/auth-admin.js issue-reset",
    "wallets:initialize": "./infrastructure/scripts/initialize-wallets.sh",
    "consortium:governance": "./infrastructure/scripts/governance-organization.sh",
    "consortium:enroll": "./infrastructure/scripts/enroll-consortium-organization.sh",
    "consortium:enroll-actor": "./infrastructure/scripts/enroll-actor-identity.sh",
    "operations:backup": "./infrastructure/scripts/backup-application-data.sh",
    "operations:restore-drill": "./infrastructure/scripts/restore-drill.sh",
    "phase4:preflight": "./infrastructure/scripts/production-readiness.sh config",
    "phase4:readiness": "./infrastructure/scripts/production-readiness.sh live",
    "phase4:deploy-chaincodes": "./infrastructure/scripts/deploy-consortium-chaincodes.sh",
    "phase4:validate-isolation": "./infrastructure/scripts/validate-channel-isolation.sh",
    "phase4:test": "python3 -m unittest discover -s infrastructure/tests -p 'test_*.py'",
    "phase4:validate-topology": "./infrastructure/scripts/validate-generated-topology.sh",
    "phase5:validate-observability": "./infrastructure/scripts/validate-phase5-observability.sh",
    "phase5:readiness": "./infrastructure/scripts/phase5-readiness.sh",
    "phase5:monitoring:up": "./infrastructure/scripts/phase5-monitoring.sh up",
    "phase5:monitoring:down": "./infrastructure/scripts/phase5-monitoring.sh down",
    "phase6:load-test": "./infrastructure/scripts/phase6-load-test.sh",
    "phase6:resilience-drill": "./infrastructure/scripts/phase6-orderer-resilience.sh",
    "phase6:evidence": "python3 ./infrastructure/scripts/build-release-evidence.py",
    "phase6:readiness": "./infrastructure/scripts/phase6-readiness.sh",
    "phase6:test": "python3 -m unittest infrastructure.tests.test_release_evidence",
    "phase6:validate-load": "./infrastructure/scripts/validate-phase6-load.sh",
    "phase7:readiness": "./infrastructure/scripts/phase7-security-readiness.sh",
    "phase8:readiness": "./infrastructure/scripts/phase8-continuity-readiness.sh",
    "phase9:finalize": "python3 ./infrastructure/scripts/finalize-go-live.py",
    "final-phases:test": "python3 -m unittest discover -s infrastructure/tests -p 'test_*.py'",
    "ui:start": "yarn workspace @synapsenet/api-gateway start",
    "web3:dev": "yarn workspace @synapsenet/web dev",
    "web3:build": "yarn workspace @synapsenet/web build",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format:js": "prettier --check .",
    "format:js:fix": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.x.x",
    "prettier": "^3.x.x",
    "@typescript-eslint/eslint-plugin": "^7.x.x",
    "@typescript-eslint/parser": "^7.x.x"
  }
}
