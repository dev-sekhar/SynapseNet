{
  "name": "synapsenet-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "chaincode/*",
    "backend-api-gateway",
    "fabric-adapter",
    "frontend-web",
    "frontend-mobile",
    "ai-services/*"
  ],
  "scripts": {
    "chaincode:build": "yarn workspace skill-manager build",
    "chaincode:test": "yarn workspace skill-manager test",
    "trust:build": "yarn workspace trust-manager build",
    "trust:test": "yarn workspace trust-manager test",
    "trust:deploy": "./scripts/deploy-trust-chaincode.sh",
    "trust:initialize": "./scripts/initialize-trust-policy.sh",
    "network:generate": "./scripts/generate-network.sh",
    "network:up": "./scripts/network-up.sh",
    "network:create-channel": "./scripts/create-channel.sh",
    "network:deploy": "./scripts/deploy-chaincode.sh",
    "network:test": "./scripts/smoke-test.sh",
    "network:down": "./scripts/network-down.sh",
    "network:reset": "./scripts/network-reset.sh",
    "users:list": "./scripts/list-users.sh",
    "auth:issue-reset": "node scripts/auth-admin.js issue-reset",
    "wallets:initialize": "./scripts/initialize-wallets.sh",
    "ui:start": "yarn workspace backend-api-gateway start",
    "web3:dev": "yarn workspace frontend-web dev",
    "web3:build": "yarn workspace frontend-web build",
    "lint:js": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format:js": "prettier --check .",
    "format:js:fix": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.x.x",
    "prettier": "^3.x.x",
    "@typescript-eslint/eslint-plugin": "^7.x.x",
    "@typescript-eslint/parser": "^7.x.x"
  }
}
