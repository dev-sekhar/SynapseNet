SYNAPSENET_SESSION_SECRET=replace-with-at-least-32-random-bytes
SYNAPSENET_ENCRYPTION_KEY=replace-with-urlsafe-base64-encoded-32-byte-key
SYNAPSENET_DATABASE_URL=sqlite+aiosqlite:///./data/synapsenet.db
SYNAPSENET_LEDGER_GATEWAY_URL=http://127.0.0.1:3001
SYNAPSENET_FABRIC_ADAPTER_URL=http://127.0.0.1:3010
SYNAPSENET_FABRIC_ADAPTER_TOKEN=replace-with-at-least-32-random-bytes
SYNAPSENET_COOKIE_SECURE=false
SYNAPSENET_PENALTY_EXECUTOR_TOKEN=replace-with-random-executor-secret
SYNAPSENET_GOVERNANCE_TOKEN=replace-with-random-governance-secret
SYNAPSENET_OPERATIONS_TOKEN=replace-with-random-operations-secret
SYNAPSENET_REQUIRE_WALLET_FOR_CREDENTIALS=true
SYNAPSENET_ALLOW_LEGACY_BUSINESS_SESSIONS=false
